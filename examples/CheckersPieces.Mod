MODULE CheckersPieces; (* FLTK's test/checkers_pieces.fl: the pieces Checkers draws *)

(* FLTK's four PNG files, test/pixmaps/black_checker.png and the rest,
   which FLUID writes into checkers_pieces.cxx, here in hexadecimal. Get
   gives one's bytes, to load with FlImages.LoadData. *)

CONST
  (* the pieces, Get's which *)
  Black* = 0; White* = 1; BlackKing* = 2; WhiteKing* = 3;
  Max* = 7548; (* the most bytes a piece has *)

VAR n: INTEGER;

(* Appends the bytes s gives, two hexadecimal digits each, to buf at n. *)
PROCEDURE Bytes(VAR buf: ARRAY OF CHAR; s: ARRAY OF CHAR);
  VAR k: INTEGER;

  PROCEDURE Digit(ch: CHAR): INTEGER;
  BEGIN
    IF ch >= "A" THEN RETURN ORD(ch) - ORD("A") + 10 ELSE RETURN ORD(ch) - ORD("0") END
  END Digit;

BEGIN
  k := 0;
  WHILE s[k] # 0X DO
    buf[n] := CHR(Digit(s[k]) * 16 + Digit(s[k + 1]));
    INC(n); INC(k, 2)
  END
END Bytes;

PROCEDURE PutBlack(VAR b: ARRAY OF CHAR);
