END PutWhiteKing;

(* Puts piece which's PNG file in buf, at least Max long, and its length in
   len. *)
PROCEDURE Get*(which: INTEGER; VAR buf: ARRAY OF CHAR; VAR len: INTEGER);
BEGIN
  n := 0;
  CASE which OF
    Black: PutBlack(buf)
  | White: PutWhite(buf)
  | BlackKing: PutBlackKing(buf)
  | WhiteKing: PutWhiteKing(buf)
  END;
  len := n
END Get;

END CheckersPieces.
