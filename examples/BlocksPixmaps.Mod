MODULE BlocksPixmaps; (* FLTK's test/pixmaps for blocks.cxx in Oberon-2 *)

(* The blocks of Blocks, FLTK's blast.xpm and a block and a bomb of each
   of its seven colours, as its blocks.cxx includes them, opened when
   this module starts. *)

IMPORT FlImages;

CONST Colors* = 7;

VAR
  blast*: FlImages.Image;
  normal*, bomb*: ARRAY Colors OF FlImages.Image;
  x: ARRAY 65, 33 OF CHAR;


(* FLTK's test/pixmaps/blast.xpm. *)
