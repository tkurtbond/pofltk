PROCEDURE ButtonCB(wgt: Fl.Widget);
  VAR a: SET;
BEGIN
  a := {};
  IF leftb.Value() THEN a := a + Fl.AlignLeft END;
  IF rightb.Value() THEN a := a + Fl.AlignRight END;
  IF topb.Value() THEN a := a + Fl.AlignTop END;
  IF bottomb.Value() THEN a := a + Fl.AlignBottom END;
  IF insideb.Value() THEN a := a + Fl.AlignInside END;
  IF overb.Value() THEN a := a + Fl.AlignTextOverImage END;
  b.SetAlign(a);
  IF inactb.Value() THEN b.Deactivate ELSE b.Activate END;
  w.Redraw
END ButtonCB;

PROCEDURE PlayCB(wgt: Fl.Widget);
BEGIN pixmap.Start; depixmap.Start
END PlayCB;

PROCEDURE StopCB(wgt: Fl.Widget);
BEGIN pixmap.Stop; depixmap.Stop
END StopCB;

PROCEDURE StepCB(wgt: Fl.Widget);
BEGIN pixmap.Next; depixmap.Next
END StepCB;

PROCEDURE Arg(i: INTEGER): INTEGER;
  VAR s: ARRAY 3 OF CHAR;
BEGIN
  Args.Get(i, s);
  IF (s[0] = "-") & (s[1] = "8") THEN dvisual := TRUE; RETURN 1 END;
  RETURN 0
END Arg;

PROCEDURE Toggle(VAR t: FlButtons.ToggleButton; x, y, wd: INTEGER; label: ARRAY OF CHAR);
BEGIN
  NEW(t); FlButtons.OpenToggleButton(t, x, y, wd, 25, label);
  t.action := ButtonCB
END Toggle;

PROCEDURE Small(VAR s: FlButtons.Button; x: INTEGER; label: ARRAY OF CHAR; cb: PROCEDURE (w: Fl.Widget));
BEGIN
  NEW(s); FlButtons.OpenButton(s, x, 50, 25, 25, label);
  s.SetLabelColor(Fl.Dark2);
  s.action := cb
END Small;

BEGIN
  IF ~Fl.ParseArgs(Arg, i) OR (i < Args.argc) THEN
    Fl.ArgsHelp(help);
    Err.String(" -8 # : use default visual"); Err.Ln; Err.String(help); Err.Ln;
    HALT(1)
  END;
  IF ~dvisual & Fl.Visual(Fl.VisualRgb) THEN END;

  NEW(w); Fl.OpenDoubleWindow(w, 400, 440, "");
  NEW(b); FlButtons.OpenButton(b, 130, 170, 140, 140, "Pixmap");

  FlImages.SetAnimateGIFs(TRUE);
  Fluid;
  NEW(pixmap);
  ASSERT(FlImages.OpenAnimGIFData(pixmap, gif, LEN(gif), b, FlImages.DontResizeCanvas));
  pixmap.SetSpeed(0.5D0);
  FlImages.SetImage(b, pixmap);

  NEW(depixmap); pixmap.Copy(depixmap, pixmap.W(), pixmap.H());
  depixmap.Inactive;
  FlImages.SetInactiveImage(b, depixmap);

  Toggle(leftb, 25, 50, 50, "left");
  Toggle(rightb, 75, 50, 50, "right");
  Toggle(topb, 125, 50, 50, "top");
  Toggle(bottomb, 175, 50, 50, "bottom");
  Toggle(insideb, 225, 50, 50, "inside");
  Toggle(overb, 25, 75, 100, "text over");
  Toggle(inactb, 125, 75, 100, "inactive");

  Small(play, 300, "@>", PlayCB);
  Small(stop, 325, "@||", StopCB);
  Small(step, 350, "@|>", StepCB);

  w.SetResizable(w);
  w.End;
  w.ShowArgs;
  Fl.Run
END Pixmap.
