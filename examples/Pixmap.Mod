MODULE Pixmap; (* FLTK's test/pixmap.cxx in Oberon-2 *)

(* An animated GIF as a button's image, and its inactive copy as the
   button's image while inactive: the toggles align the label, or make
   the button inactive, and the three small buttons play, stop and step
   both. The GIF is FLTK's test/pixmaps/animated_fluid_gif.h, here in
   hexadecimal, decoded at start. -8 is FLTK's option for the default
   visual, not an RGB one. *)

IMPORT Args, Err, Fl, FlButtons, FlImages;

VAR
  leftb, rightb, topb, bottomb, insideb, overb, inactb: FlButtons.ToggleButton;
  b, play, stop, step: FlButtons.Button;
  w: Fl.DoubleWindow;
  pixmap, depixmap: FlImages.AnimGIF;
  gif: ARRAY 2545 OF CHAR;
  n, i: INTEGER;
  dvisual: BOOLEAN;
  help: ARRAY 4096 OF CHAR;

(* Appends the bytes s gives, two hexadecimal digits each, to gif. *)
PROCEDURE Bytes(s: ARRAY OF CHAR);
  VAR k: INTEGER;

  PROCEDURE Digit(ch: CHAR): INTEGER;
  BEGIN
    IF ch >= "A" THEN RETURN ORD(ch) - ORD("A") + 10 ELSE RETURN ORD(ch) - ORD("0") END
  END Digit;

BEGIN
  k := 0;
  WHILE s[k] # 0X DO
    gif[n] := CHR(Digit(s[k]) * 16 + Digit(s[k + 1]));
    INC(n); INC(k, 2)
  END
END Bytes;

